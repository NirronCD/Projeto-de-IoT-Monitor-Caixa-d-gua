    [ "sonar:TRIG", "esp:5", "green", [] ],
    [ "sonar:ECHO", "esp:18", "yellow", [] ],

    [ "relay:VCC", "esp:5V", "red", [] ],
    [ "relay:GND", "esp:GND.2", "black", [] ],
    [ "relay:IN", "esp:23", "orange", [] ],
    [ "relay:COM", "esp:3V3", "red", [] ],
    [ "relay:NO", "r_bomba:1", "orange", [] ],
    [ "r_bomba:2", "led_bomba:A", "orange", [] ],
    [ "led_bomba:C", "esp:GND.2", "black", [] ],

    [ "esp:25", "r_r:2", "red", [] ],
    [ "esp:26", "r_g:2", "green", [] ],
    [ "esp:27", "r_b:2", "blue", [] ],
    [ "r_r:1", "rgb:R", "red", [] ],
    [ "r_g:1", "rgb:G", "green", [] ],
    [ "r_b:1", "rgb:B", "blue", [] ],
    [ "rgb:COM", "esp:GND.1", "black", [] ],

    [ "buzzer:2", "esp:13", "purple", [] ],
    [ "buzzer:1", "esp:GND.3", "black", [] ]
