    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "sonar", "top": -170, "left": -40, "attrs": { "distance": "60" } },
    { "type": "wokwi-relay-module", "id": "relay", "top": 20, "left": 220, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r_bomba", "top": -40, "left": 380, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_bomba", "top": -120, "left": 420, "attrs": { "color": "blue", "label": "Bomba" } },
    { "type": "wokwi-rgb-led", "id": "rgb", "top": 210, "left": -200, "attrs": { "common": "cathode" } },
    { "type": "wokwi-resistor", "id": "r_r", "top": 130, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_g", "top": 160, "left": -150, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_b", "top": 190, "left": -150, "attrs": { "value": "220" } },
